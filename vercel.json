{
    "version": 2,
    "rewrites": [
        {
            "source": "/api/generateToken",
            "destination": "/api/generateToken.js"
        },
        {
            "source": "/api/generateQuiz",
            "destination": "/api/generateQuiz.js"
        },
        {
            "source": "/api/generateChatResponse",
            "destination": "/api/generateChatResponse.js"
        },
        {
            "source": "/api/generateInsight",
            "destination": "/api/generateInsight.js"
        },
        {
            "source": "/api/generateReadingPlan",
            "destination": "/api/generateReadingPlan.js"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "functions": {
        "api/*.js": {
            "memory": 1024,
            "maxDuration": 30
        }
    }
}