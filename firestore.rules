rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@gmail.com' || 
        request.auth.token.email == 'kosselvotes3@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    /**
     * @Collection - User Profiles
     */
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) || isAdmin()) && 
                    (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || isAdmin());
      allow delete: if isAdmin();
    }

    /**
     * @Collection - Direct Messages & Conversations
     */
    match /direct_messages/{messageId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participants);
      allow create: if isAuthenticated() && (request.auth.uid == request.resource.data.senderUid && request.auth.uid in request.resource.data.participants);
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.participants);
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.senderUid);
    }
    
    match /conversations/{convId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participants);
      allow write: if isAuthenticated() && (request.auth.uid in request.resource.data.participants);
    }

    match /community_chats/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || request.resource.data.uid == 'doxa-ai');
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    /**
     * @Collection - Content Collections (ReadOnly for public, Managed by Admin)
     */
    match /stories/{storyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    match /global_reactions/{reactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
    }

    match /e_books/{bookId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sermons/{sermonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonies/{testimonyId} {
      allow read: if resource.data.approved == true || 
                     (isAuthenticated() && resource.data.uid == request.auth.uid) || 
                     isAdmin();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    /**
     * @Collection - Ministry & Support
     */
    match /prayer_requests/{requestId} {
      allow read: if (isAuthenticated() && resource.data.uid == request.auth.uid) ||
                     (resource.data.approved == true && resource.data.isPrivate == false) ||
                     (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'prayer') ||
                     isAdmin();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() || 
                     (isAuthenticated() && 
                      ((request.auth.uid == resource.data.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'isPrivate'])) ||
                       (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'prayer' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completed', 'prayedBy', 'prayedCount']))));
      allow delete: if isAdmin();
    }

    /**
     * @Collection - Attendance & Activity
     */
    match /attendance_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();

      match /attendees/{userId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }
    }

    match /bible_quizzes/{quizId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /quiz_scores/{scoreId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin()) && 
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
      allow create: if isAdmin(); 
      allow delete: if isAdmin();
    }

    /**
     * @Collection - Systems & Config
     */
    match /live_rooms/{roomId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
      
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
        allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      }
    }

    match /live_participants/{participantId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && participantId == request.auth.uid;
    }

    match /site_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /giving_stats/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /user_bible_data/{docId} {
      allow read, write: if isAuthenticated() && docId.matches(request.auth.uid + '_.*');
    }

    match /study_plans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /study_notes/{noteId} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /service_review_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /service_reviews/{reviewId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }


    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}